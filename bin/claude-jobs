#!/bin/bash
# Guardián de trabajos programados: revisa en los logs si los jobs de tu bot
# corrieron a la hora que tenían que correr, y te avisa sólo si falta alguno.
#
# Usa Claude con el conector de Railway (los logs), así que no hace falta
# tener el CLI de Railway ni un token guardado.
#
#   claude-jobs              revisa ahora
#   claude-jobs --instalar   lo deja corriendo todos los días (hora configurable)
#   claude-jobs --desinstalar
#
# Config en ~/.config/claude-gadgets/config:
#   JOBS_SERVICIO="el servicio web del proyecto tu-proyecto"
#   JOBS=("ypf_diario|08:15|baja precios y avisa"
#         "guardian_volcados|07:00|")
#   JOBS_HORA=10      # a qué hora revisa (una vez por día)
# Sin JOBS, revisa TODO Railway: cada proyecto y servicio (también los que
# crees después), buscando jobs programados que fallaron, deploys caídos y
# errores que se repiten en las últimas 24 horas.
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
export LANG=${LANG:-es_AR.UTF-8}
conf=~/.config/claude-gadgets/config
[ -f "$conf" ] && . "$conf"
[ -f $HOME/.claude/gadgets/bin/comun.sh ] && . $HOME/.claude/gadgets/bin/comun.sh   # avisos, timers y no molestar
# OJO: acá NO se usa el token de `claude setup-token`. Con ese login los
# conectores de claude.ai (Railway, Gmail…) no están disponibles; con la sesión
# normal de la compu sí. Por eso este gadget corre local (timer de systemd), no por SSH.
est=~/.claude/estado; mkdir -p "$est"
log="$est/jobs.log"; salida="$est/jobs.json"

avisar() { local t=${1//\"/\'} m=${2//\"/\'}
  if declare -f en_silencio >/dev/null && en_silencio "${4:-}"; then
    printf '%s | (en silencio) %s: %s\n' "$(date '+%d/%m %H:%M')" "$1" "$2" >> "$log"; return; fi
  notificar "$t" "$m" "${3:-error}"
  [ -n "$NTFY_TOPIC" ] && curl -s -m 5 -H "Title: $1" -d "$2" "https://ntfy.sh/$NTFY_TOPIC" >/dev/null &
  printf '%s | %s: %s\n' "$(date '+%d/%m %H:%M')" "$1" "$2" >> "$log"; }

case "${1:-}" in
  --instalar)
    timer_instalar jobs "hora:$(printf %02d "${JOBS_HORA:-10}"):00" \
      && echo "✓ Reviso los jobs todos los días a las ${JOBS_HORA:-10}:00"; exit 0 ;;
  --desinstalar) timer_desinstalar jobs; echo "✓ Guardián de jobs apagado"; exit 0 ;;
  --ultimo) [ -f "$salida" ] && jq -r '.[] | "\(if .ok then "OK " else "FALTA" end) \(.id): \(.detalle)"' "$salida"; exit 0 ;;
esac

lista=""
for fila in "${JOBS[@]}"; do
  IFS='|' read -r id hora que <<<"$fila"
  lista+="- $id: tenía que correr hoy a las $hora${que:+ ($que)}"$'\n'
done

if [ ${#JOBS[@]} -eq 0 ]; then
pedido="Revisá TODOS los proyectos y servicios de Railway de mi cuenta (listalos, no te saltees ninguno).
Para cada servicio mirá el estado del último deploy y los logs de las últimas 24 horas:
- trabajos programados (jobs, cron, scheduler, tareas diarias) que fallaron, tiraron excepción o no corrieron;
- deploy caído, crasheado o reiniciándose;
- errores que se repiten mucho.
Sólo mirá: no cambies, reinicies ni redeployes nada.
Respondé SÓLO un JSON, sin texto alrededor, un elemento por servicio:
[{\"id\":\"proyecto/servicio\",\"ok\":true,\"detalle\":\"3 jobs corrieron bien\"}]
ok=false sólo si hay algo para arreglar. En detalle, una frase corta en castellano."
else
pedido="Revisá en los logs de Railway de ${JOBS_SERVICIO:-el servicio principal} si estos trabajos programados corrieron HOY:
$lista
Para cada uno buscá su rastro en los logs de hoy (nombre del job, errores, excepciones).
Respondé SÓLO un JSON, sin texto alrededor, con esta forma:
[{\"id\":\"...\",\"ok\":true,\"detalle\":\"corrió 08:15, 1703 filas\"}]
ok=false si no corrió, si falló, o si no encontrás rastro. En detalle, una frase corta en castellano."
fi

respuesta=$(claude -p "$pedido" --no-session-persistence --model sonnet --permission-mode dontAsk \
  --allowedTools "mcp__claude_ai_Railway__get-logs" "mcp__claude_ai_Railway__list-projects" \
                 "mcp__claude_ai_Railway__list-services" "mcp__claude_ai_Railway__list-deployments" \
                 "mcp__claude_ai_Railway__get-status" "mcp__claude_ai_Railway__list-workspaces" \
  </dev/null 2>&1)

# El modelo a veces lo envuelve en ```json: me quedo con el array más grande.
json=$(python3 -c "
import sys
t = sys.stdin.read()
i, j = t.find('['), t.rfind(']')
print(t[i:j+1] if i >= 0 and j > i else '')" <<<"$respuesta")
if ! jq -e . >/dev/null 2>&1 <<<"$json"; then
  avisar "Guardián de jobs" "No pude leer los logs (¿Railway conectado?). Mirá $log"
  printf '%s | respuesta sin JSON: %s\n' "$(date '+%d/%m %H:%M')" "$(cut -c1-200 <<<"$respuesta")" >> "$log"
  exit 1
fi
printf '%s' "$json" > "$salida"

faltan=$(jq -r '[.[] | select(.ok | not)] | length' <<<"$json")
if [ "$faltan" -gt 0 ]; then
  detalle=$(jq -r '[.[] | select(.ok | not) | "\(.id): \(.detalle)"] | join(" · ")' <<<"$json")
  avisar "⚠️ $faltan trabajo(s) sin correr" "$detalle" error
else
  printf '%s | todos los jobs corrieron: %s\n' "$(date '+%d/%m %H:%M')" \
    "$(jq -r '[.[].id] | join(", ")' <<<"$json")" >> "$log"
fi
jq -r '.[] | "\(if .ok then "OK   " else "FALTA" end) \(.id): \(.detalle)"' <<<"$json"
