#!/bin/bash
# Resumir: un link, un PDF, un documento o un texto largo, en pocas líneas.
#   claude-resumir https://…            una página web
#   claude-resumir informe.pdf          un PDF, .docx, .txt, .md…
#   cat acta.txt | claude-resumir       lo que le pases por un caño
#   claude-resumir --ventana …          muestra el resumen en una ventana (para menús y atajos)
#   claude-resumir -p "¿qué plazos hay?" archivo.pdf    en vez de resumir, le preguntás
# Claude no navega ni abre nada: el texto lo bajo y lo leo yo, y se lo paso.
# Config: RESUMIR_MODELO=sonnet
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
export LANG=${LANG:-es_AR.UTF-8}
[ -f $HOME/.config/claude-gadgets/config ] && . $HOME/.config/claude-gadgets/config
[ -f $HOME/.claude/gadgets/bin/comun.sh ] && . $HOME/.claude/gadgets/bin/comun.sh
cache="${XDG_CACHE_HOME:-$HOME/.cache}/claude-gadgets"; mkdir -p "$cache"

en_ventana=""; pedido="Resumí esto en castellano rioplatense: primero una línea con de qué se trata, después 3 a 6 puntos con lo importante (cifras, fechas, plazos, nombres). Texto plano, sin markdown salvo guiones."
while [ $# -gt 0 ]; do
  case "$1" in
    --ventana) en_ventana=1; shift ;;
    -p) pedido="Contestá en castellano rioplatense, corto y concreto, usando sólo el texto: $2"; shift 2 ;;
    -h|--help) sed -n 2,10p "$0"; exit 0 ;;
    *) break ;;
  esac
done

a_texto() {  # archivo → texto
  case "$(file -b --mime-type -- "$1")" in
    application/pdf) command -v pdftotext >/dev/null && pdftotext -layout -- "$1" - 2>/dev/null || echo "(falta pdftotext: sudo apt install poppler-utils)" ;;
    application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.oasis.opendocument.text|application/msword)
      if command -v pandoc >/dev/null; then pandoc -t plain -- "$1" 2>/dev/null
      else python3 -I -c 'import sys,zipfile,re; z=zipfile.ZipFile(sys.argv[1]); n=[x for x in z.namelist() if x in("word/document.xml","content.xml")][0]; print(re.sub(r"<[^>]+>"," ",re.sub(r"</(w:p|text:p)>","\n",z.read(n).decode())))' "$1"; fi ;;
    text/html) web_a_texto < "$1" ;;
    text/*|application/json|application/xml) cat -- "$1" ;;
    *) echo "(no sé leer este tipo de archivo: $(file -b -- "$1"))" ;;
  esac
}
web_a_texto() {  # HTML por la entrada → texto, sin scripts ni menús
  python3 -I -c '
import sys, html.parser
class P(html.parser.HTMLParser):
    salto = {"p","br","div","li","h1","h2","h3","h4","tr","section","article"}
    fuera = {"script","style","noscript","svg","nav","footer","header","form"}
    def __init__(s): super().__init__(); s.t=[]; s.n=0
    def handle_starttag(s, t, a):
        if t in s.fuera: s.n+=1
        elif t in s.salto: s.t.append("\n")
    def handle_endtag(s, t):
        if t in s.fuera and s.n: s.n-=1
    def handle_data(s, d):
        if not s.n: s.t.append(d)
p=P(); p.feed(sys.stdin.read())
print("\n".join(l.strip() for l in "".join(p.t).splitlines() if l.strip()))'
}

origen=${1:-}
if [ -z "$origen" ]; then texto=$(cat); origen="texto"
elif [[ "$origen" =~ ^https?:// ]]; then
  [ -n "$en_ventana" ] && notificar "Claude" "Leyendo el link…"
  texto=$(curl -fsSL -m 25 -A "Mozilla/5.0 (X11; Linux x86_64)" -- "$origen" 2>/dev/null) || { echo "No pude bajar $origen"; exit 1; }
  case "$texto" in *"<html"*|*"<HTML"*|*"<!DOCTYPE"*|*"<!doctype"*) texto=$(web_a_texto <<<"$texto") ;; esac
elif [ -f "$origen" ]; then texto=$(a_texto "$origen")
else echo "No encuentro «$origen» (¿es un archivo o un link?)"; exit 1; fi
[ -n "${texto// /}" ] || { echo "No encontré texto para leer en $origen."; exit 1; }

r=$(claude_texto "${RESUMIR_MODELO:-sonnet}" "$pedido
Origen: $origen

$(head -c 120000 <<<"$texto")")
[ -n "$r" ] || { echo "Claude no contestó; probá de nuevo."; exit 1; }
if [ -n "$en_ventana" ]; then printf '%s\n' "$r" > "$cache/resumen.txt"; ventana "Resumen · $(basename "$origen")" "$cache/resumen.txt"
else printf '%s\n' "$r"; fi
