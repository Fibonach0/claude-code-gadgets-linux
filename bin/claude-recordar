#!/bin/bash
# Recordatorios en castellano: decís cuándo y qué, y a esa hora te avisa con
# notificación y sonido (y al teléfono, si no estás y tenés claude-celular).
# Sobreviven a un reinicio: si la compu estaba apagada, avisa al volver.
#   claude-recordar en 20 minutos sacar la pizza
#   claude-recordar mañana a las 9 llamar al contador
#   claude-recordar el viernes 18:30 partido
#   claude-recordar                  lista los pendientes
#   claude-recordar --borrar 2       borra el segundo de la lista
#   claude-recordar --desinstalar    apaga el timer y borra todos
# Config: RECORDAR_VOZ=1 (además lo dice en voz alta) · RECORDAR_MODELO=haiku
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
export LANG=${LANG:-es_AR.UTF-8}
[ -f ~/.config/claude-gadgets/config ] && . ~/.config/claude-gadgets/config
[ -f $HOME/.claude/gadgets/bin/comun.sh ] && . $HOME/.claude/gadgets/bin/comun.sh
est=${CLAUDE_ESTADO:-$HOME/.claude/estado}; lista="$est/recordatorios"; mkdir -p "$est"; touch "$lista"

mostrar() {
  [ -s "$lista" ] || { echo "No hay recordatorios pendientes."; return; }
  sort -n "$lista" | awk -F'|' '{cmd = "date -d @" $1 " \"+%a %d/%m %H:%M\""; cmd | getline f; close(cmd); printf "  %d. %s — %s\n", NR, f, $2}'
}

case "${1:-}" in
  "") mostrar; exit 0 ;;
  -h|--help) sed -n 2,11p "$0"; exit 0 ;;
  --borrar)
    [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "Decime cuál: claude-recordar --borrar 2"; exit 1; }
    sort -n "$lista" | sed "${2}d" > "$lista.tmp" && mv "$lista.tmp" "$lista"; mostrar; exit 0 ;;
  --desinstalar) timer_desinstalar recordar; rm -f "$lista"; echo "✓ Recordatorios apagados"; exit 0 ;;
  --revisar)   # lo que corre cada minuto
    ahora=$(date +%s); queda=""
    while IFS='|' read -r cuando texto; do
      [ -n "$cuando" ] || continue
      if [ "$cuando" -le "$ahora" ]; then
        tarde=$(( (ahora - cuando) / 60 ))
        notificar "⏰ $texto" "$([ $tarde -gt 5 ] && echo "Era a las $(date -d @"$cuando" +%H:%M)" || echo "Recordatorio")" recordatorio
        [ "${RECORDAR_VOZ:-0}" = 1 ] && hablar "Recordatorio: $texto" >/dev/null 2>&1 &
      else queda+="$cuando|$texto"$'\n'; fi
    done < "$lista"
    printf '%s' "$queda" > "$lista"
    [ -s "$lista" ] || timer_desinstalar recordar    # sin pendientes no hace falta seguir despertándose
    exit 0 ;;
esac

pedido="$*"
# Lo más común se resuelve acá, sin consultar a nadie: «en 20 minutos …».
if [[ "$pedido" =~ ^en[[:space:]]+([0-9]+|un|una|media)[[:space:]]+(min|minuto|minutos|h|hora|horas)[[:space:]]+(.+)$ ]]; then
  n=${BASH_REMATCH[1]}; u=${BASH_REMATCH[2]}; texto=${BASH_REMATCH[3]}
  case "$n" in un|una) n=1 ;; media) n=30; u=min ;; esac
  case "$u" in h*) seg=$((n * 3600)) ;; *) seg=$((n * 60)) ;; esac
  cuando=$(( $(date +%s) + seg ))
else
  r=$(claude_texto "${RECORDAR_MODELO:-haiku}" "Ahora es $(date '+%A %Y-%m-%d %H:%M') (hora local). Separá este recordatorio en CUÁNDO y QUÉ:
«$pedido»
Respondé EXACTAMENTE un renglón con este formato y nada más:
AAAA-MM-DD HH:MM|texto del recordatorio
Si no dice hora, usá las 09:00. Si la hora ya pasó hoy y no dice día, es mañana. El texto va sin la parte del cuándo, con mayúscula inicial. Si no se entiende cuándo, respondé: ERROR" | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}\|' | head -1)
  [ -n "$r" ] || { echo "No entendí cuándo. Probá: claude-recordar mañana a las 9 llamar al contador"; exit 1; }
  cuando=$(date -d "${r%%|*}" +%s 2>/dev/null) || { echo "No entendí la fecha «${r%%|*}»."; exit 1; }
  texto=${r#*|}
fi
[ "$cuando" -gt "$(date +%s)" ] || { echo "Eso ya pasó ($(date -d @"$cuando" '+%d/%m %H:%M'))."; exit 1; }
texto=${texto//|/ }
echo "$cuando|$texto" >> "$lista"
systemctl --user is-active claude-gadgets-recordar.timer >/dev/null 2>&1 || timer_instalar recordar cada:60 --revisar \
  || echo "(sin systemd no puedo despertarme solo: corré «claude-recordar --revisar» desde cron cada minuto)"
echo "✓ $(date -d @"$cuando" '+%A %d/%m a las %H:%M'): $texto"
