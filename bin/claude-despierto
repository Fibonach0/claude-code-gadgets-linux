#!/bin/bash
# Despierto: mientras haya una sesión de Claude Code trabajando, la compu no se
# suspende sola. Cuando terminan, vuelve a dormirse como siempre.
#   claude-despierto                 ¿la estoy manteniendo despierta ahora?
#   claude-despierto --instalar / --desinstalar
# No toca tu configuración de energía: pone un «inhibidor» de systemd que se
# vence solo a los dos minutos y se renueva mientras haya trabajo.
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
[ -f ~/.config/claude-gadgets/config ] && . ~/.config/claude-gadgets/config
[ -f $HOME/.claude/gadgets/bin/comun.sh ] && . $HOME/.claude/gadgets/bin/comun.sh
est=${CLAUDE_ESTADO:-$HOME/.claude/estado}

trabajando() {  # sesiones con actividad en la última media hora
  local n=0 f e ts ahora; ahora=$(date +%s)
  for f in "$est"/sesion-*.json; do
    [ -f "$f" ] || continue
    read -r e ts < <(jq -r '"\(.estado) \(.ts // 0)"' "$f" 2>/dev/null)
    [ "$e" = trabajando ] && [ $((ahora - ts)) -le "${DESPIERTO_MAX:-1800}" ] && n=$((n + 1))
  done
  echo "$n"
}

case "${1:-}" in
  --instalar) timer_instalar despierto cada:60 --revisar && echo "✓ La compu no se va a suspender mientras Claude trabaje"; exit 0 ;;
  --desinstalar) timer_desinstalar despierto; echo "✓ Apagado: la compu se suspende como siempre"; exit 0 ;;
  -h|--help) sed -n 2,8p "$0"; exit 0 ;;
  --revisar)
    [ "$(trabajando)" -gt 0 ] || exit 0
    # En una unidad aparte: si quedara colgando de este servicio, systemd la mataría al salir.
    systemd-run --user --quiet --collect systemd-inhibit --what=sleep:idle --who="Claude Code" \
      --why="Hay sesiones de Claude trabajando" sleep 130 2>/dev/null
    exit 0 ;;
esac
n=$(trabajando)
if systemd-inhibit --list --no-pager 2>/dev/null | grep -q "Claude Code"; then echo "Manteniendo la compu despierta: $n sesión(es) trabajando."
elif systemctl --user is-active claude-gadgets-despierto.timer >/dev/null 2>&1; then echo "Prendido, pero ahora no hace falta: $n sesión(es) trabajando."
else echo "Apagado (claude-despierto --instalar). Ahora hay $n sesión(es) trabajando."; fi
