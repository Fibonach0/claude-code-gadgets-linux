#!/bin/bash
# Carpeta mágica: dejás un archivo (foto, PDF, Excel, texto) en una carpeta y
# Claude lo lee, escribe una ficha en .md al lado y te avisa. Si esa carpeta se
# sincroniza (Syncthing, Nextcloud, Dropbox, rclone…), podés tirar cosas desde
# el celular.
#
# Uso:
#   claude-buzon               procesa lo que haya (lo que corre el timer)
#   claude-buzon --instalar    lo deja escuchando la carpeta (y cada 5 min)
#   claude-buzon --desinstalar
#
# Config en ~/.config/claude-gadgets/config:
#   BUZON="$HOME/Para Claude"
#   BUZON_MODELO="sonnet"
# Si dejás un archivo `_instrucciones.md` dentro de la carpeta, su contenido se
# le suma al pedido: sirve para decirle qué datos te importan de cada papel.
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
export LANG=${LANG:-es_AR.UTF-8}
conf=~/.config/claude-gadgets/config
[ -f "$conf" ] && . "$conf"
[ -f $HOME/.claude/gadgets/bin/comun.sh ] && . $HOME/.claude/gadgets/bin/comun.sh   # avisos, timers y no molestar
tok=~/.config/claude-gadgets/token
[ -z "$CLAUDE_CODE_OAUTH_TOKEN" ] && [ -f "$tok" ] && export CLAUDE_CODE_OAUTH_TOKEN="$(tr -d '[:space:]' < "$tok")"
buzon="${BUZON:-$HOME/Para Claude}"
listos="$buzon/Procesados"
log=~/.claude/estado/buzon.log

avisar() { local t=${1//\"/\'} m=${2//\"/\'}
  if declare -f en_silencio >/dev/null && en_silencio "${4:-}"; then
    printf '%s | (en silencio) %s: %s\n' "$(date '+%d/%m %H:%M')" "$1" "$2" >> "$log"; return; fi
  notificar "$t" "$m" "${3:-aviso}"
  [ -n "$NTFY_TOPIC" ] && curl -s -m 5 -H "Title: $1" -d "$2" "https://ntfy.sh/$NTFY_TOPIC" >/dev/null &
  printf '%s | %s: %s\n' "$(date '+%d/%m %H:%M')" "$1" "$2" >> "$log"; }

case "${1:-}" in
  --instalar)
    mkdir -p "$buzon" "$listos"
    [ -f "$buzon/_instrucciones.md" ] || cat > "$buzon/_instrucciones.md" <<'TXT'
# Qué hacer con lo que dejo acá

Leé el archivo y escribí una ficha corta en castellano: qué es, de quién,
fecha, importes, números de documento y cualquier dato que haya que cargar
después. Si falta algo o algo no se entiende, decilo al final en "Dudas".
TXT
    TIMER_VIGILAR="$buzon" timer_instalar buzon cada:300 \
      && echo "✓ Buzón escuchando: $buzon"; exit 0 ;;
  --desinstalar) timer_desinstalar buzon; echo "✓ Buzón apagado"; exit 0 ;;
esac

[ -d "$buzon" ] || { echo "No existe la carpeta: $buzon (corré claude-buzon --instalar)"; exit 1; }
mkdir -p "$listos"
shopt -s nullglob

# Carpetas a mirar: el buzón y sus subcarpetas (menos Procesados). Cada una
# puede tener su propio _instrucciones.md: así "Fojas y REM" pide una cosa y el
# buzón general otra.
carpetas=("$buzon")
for sub in "$buzon"/*/; do
  sub=${sub%/}
  [ "$(basename "$sub")" = "$(basename "$listos")" ] && continue
  carpetas+=("$sub")
done

for carpeta in "${carpetas[@]}"; do
listos="$carpeta/Procesados"; mkdir -p "$listos"
extras=""
for i in "$carpeta/_instrucciones.md" "$buzon/_instrucciones.md"; do
  [ -f "$i" ] && { extras=$(cat "$i"); break; }
done
for f in "$carpeta"/*; do
  [ -f "$f" ] || continue
  n=$(basename "$f")
  case "$n" in .*|_instrucciones.md|*.md) continue ;; esac
  # Temporales de quien esté sincronizando o bajando: todavía no es el archivo.
  case "$n" in *.part|*.tmp|*.crdownload|*~) continue ;; esac
  # Que no esté copiándose todavía: el tamaño tiene que quedar quieto.
  t1=$(stat -c %s "$f"); sleep 2; [ "$t1" != "$(stat -c %s "$f")" ] && continue
  [ "$t1" -eq 0 ] && continue

  ext=$(echo "${n##*.}" | tr 'A-Z' 'a-z')
  tmp=""; leer_esto="el archivo $n de esta carpeta"
  case "$ext" in
    pdf|png|jpg|jpeg|heic|webp|gif|txt|md|csv|tsv|json|log|xml|html) : ;;
    xlsx|xlsm)   # Read no abre Excel: lo paso a CSV, una hoja por archivo
      tmp=$(mktemp -d)
      if ! python3 "$HOME/.claude/gadgets/bin/xlsx2csv.py" "$f" "$tmp" 2>/dev/null; then
        avisar "Buzon: no pude convertir $n" "Hace falta python3 con openpyxl" error; rm -rf "$tmp"; continue; fi
      leer_esto="los CSV que están en $tmp (son las hojas de $n)" ;;
    *) avisar "Buzon: $n" "No puedo leer archivos .$ext; lo dejo donde está" error; continue ;;
  esac

  ficha="$listos/${n%.*}.md"
  [ -f "$ficha" ] && ficha="$listos/${n%.*}-$(date +%H%M%S).md"
  avisar "Buzón" "Leyendo ${n}"
  {
    echo "# $n"; echo; echo "_Procesado $(date '+%d/%m/%Y %H:%M')_"; echo
    claude -p "Leé $leer_esto (carpeta: $(basename "$carpeta")) y escribí la ficha.

$extras

Formato: markdown corto, con los datos en viñetas. Sin preámbulos." \
      --no-session-persistence --model "${BUZON_MODELO:-sonnet}" \
      --permission-mode dontAsk --allowedTools "Read" "Grep" "Glob" \
      --add-dir "$carpeta" ${tmp:+--add-dir "$tmp"} </dev/null 2>&1
  } > "$ficha"
  [ -n "$tmp" ] && rm -rf "$tmp"
  if [ -s "$ficha" ] && ! grep -qiE "no puedo|no pude|bloque|permis" "$ficha"; then
    mv "$f" "$listos/$n"
    avisar "✅ Buzón: $n" "$(sed -n '5,7p' "$ficha" | tr '\n' ' ' | cut -c1-120)" listo
  else
    avisar "❌ Buzón: no pude con $n" "Quedó en la carpeta para reintentar" error
  fi
done
done
