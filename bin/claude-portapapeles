#!/bin/bash
# Claude sobre lo que tengas seleccionado: marcás un texto en cualquier
# programa, apretás el atajo y elegís qué hacer (explicar, resumir, traducir,
# corregir, responder…). La respuesta aparece en una ventana y, cuando es un
# texto para pegar (traducción, corrección, respuesta), ya queda copiada.
#   claude-portapapeles                 menú sobre lo seleccionado (o lo copiado)
#   claude-portapapeles traducir        directo, sin menú: explicar | resumir |
#                                       traducir | ingles | corregir | responder | leer
#   claude-portapapeles --instalar [atajo]    atajo en GNOME (<Shift><Super>x)
#   claude-portapapeles --desinstalar
# Config: PORTAPAPELES_MODELO=sonnet
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
[ -f $HOME/.config/claude-gadgets/config ] && . $HOME/.config/claude-gadgets/config
[ -f $HOME/.claude/gadgets/bin/comun.sh ] && . $HOME/.claude/gadgets/bin/comun.sh

case "${1:-}" in
  --instalar)
    atajo_instalar portapapeles "Claude sobre lo seleccionado" "$HOME/.claude/gadgets/bin/claude-portapapeles" "${2:-<Shift><Super>x}" \
      && echo "✓ Atajo listo: ${2:-<Shift><Super>x} → seleccionás un texto y elegís qué hacer"; exit 0 ;;
  --desinstalar) atajo_desinstalar portapapeles; echo "✓ Atajo quitado"; exit 0 ;;
  -h|--help) sed -n 2,11p "$0"; exit 0 ;;
esac

texto=${CLAUDE_TEXTO:-$(pegar)}
[ -n "${texto//[[:space:]]/}" ] || { notificar "Claude" "No hay nada seleccionado ni copiado" error; exit 1; }
texto=${texto:0:40000}

accion=${1:-}
if [ -z "$accion" ]; then
  command -v zenity >/dev/null || { echo "Sin zenity, decime qué hacer: claude-portapapeles explicar|resumir|traducir|ingles|corregir|responder"; exit 1; }
  muestra=$(tr '\n' ' ' <<<"$texto" | cut -c1-90)
  accion=$(zenity --list --title="Claude" --text="«$muestra…»" --width=440 --height=380 --hide-header \
      --hide-column=1 --print-column=1 --column=id --column="¿Qué hago?" \
      explicar "Explicámelo" resumir "Resumilo" traducir "Traducilo al castellano" ingles "Traducilo al inglés" \
      corregir "Corregí la redacción" responder "Escribí una respuesta" leer "Leémelo en voz alta" otra "Otra cosa…" 2>/dev/null) || exit 0
fi

pegable=0
case "$accion" in
  explicar)  pedido="Explicame esto de forma clara y breve. Si es un error o un comando, decime qué significa y qué hacer." ;;
  resumir)   pedido="Resumí esto en pocas líneas: lo importante primero." ;;
  traducir)  pedido="Traducí esto al castellano rioplatense. Respondé sólo con la traducción."; pegable=1 ;;
  ingles)    pedido="Traducí esto a un inglés natural. Respondé sólo con la traducción."; pegable=1 ;;
  corregir)  pedido="Corregí ortografía, puntuación y redacción sin cambiar el tono ni el sentido. Respondé sólo con el texto corregido, en su mismo idioma."; pegable=1 ;;
  responder) pedido="Esto es un mensaje que recibí. Escribí una respuesta breve y cordial en el mismo idioma, lista para enviar. Respondé sólo con el texto de la respuesta."; pegable=1 ;;
  leer)      hablar "$texto"; exit ;;
  otra)      pedido=$(zenity --entry --title="Claude" --width=520 --text="¿Qué hago con ese texto?" 2>/dev/null) || exit 0
             [ -n "$pedido" ] || exit 0 ;;
  *)         pedido="$*" ;;     # cualquier otra cosa es el pedido tal cual
esac

[ -n "${CLAUDE_NO_ABRIR:-}" ] || notificar "Claude" "Pensando…"
dir="${XDG_CACHE_HOME:-$HOME/.cache}/claude-gadgets/portapapeles"; mkdir -p "$dir"
find "$dir" -type f -mtime +2 -delete 2>/dev/null
salida="$dir/respuesta-$(date +%Y%m%d-%H%M%S).txt"
claude_texto "${PORTAPAPELES_MODELO:-sonnet}" "$pedido
Texto plano, sin markdown ni asteriscos.

<texto>
$texto
</texto>" > "$salida"
[ -s "$salida" ] || { notificar "Claude" "No pude consultar a Claude" error; exit 1; }

if [ -n "${CLAUDE_NO_ABRIR:-}" ]; then cat "$salida"; exit 0; fi
[ $pegable = 1 ] && copiar < "$salida" && notificar "Claude" "Listo: ya está copiado, pegalo con Ctrl+V" ok || sonar aviso
ventana "Claude · $accion" "$salida"
