#!/bin/bash
# Vigía de internet: cuando se corta, anota desde cuándo; cuando vuelve, te
# avisa cuánto duró (en la compu y, si tenés claude-celular, en el teléfono).
# Y a pedido, el parte de la red en una pantalla.
#   claude-red                 el parte: conexión, latencia, DNS, IP pública, wifi
#   claude-red --cortes        los últimos cortes
#   claude-red --instalar / --desinstalar      mira cada minuto
# Config: RED_PING=1.1.1.1 · RED_MINIMO=2 (minutos para considerar que fue un corte)
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export LANG=${LANG:-es_AR.UTF-8} LC_NUMERIC=C
[ -f $HOME/.config/claude-gadgets/config ] && . $HOME/.config/claude-gadgets/config
[ -f $HOME/.claude/gadgets/bin/comun.sh ] && . $HOME/.claude/gadgets/bin/comun.sh
est=${CLAUDE_ESTADO:-$HOME/.claude/estado}; mkdir -p "$est"
caido="$est/red-caida-desde"; hist="$est/red-cortes.log"
blanco=${RED_PING:-1.1.1.1}

hay_internet() {  # dos chances, a dos destinos, para no confundir un paquete perdido con un corte
  ping -c1 -W3 "$blanco" >/dev/null 2>&1 || ping -c1 -W3 8.8.8.8 >/dev/null 2>&1 \
    || curl -fsS -m 6 -o /dev/null https://www.google.com/generate_204 2>/dev/null
}
duracion() { local s=$1; [ $s -ge 3600 ] && echo "$((s/3600)) h $((s%3600/60)) min" || { [ $s -ge 60 ] && echo "$((s/60)) min" || echo "$s s"; }; }

case "${1:-}" in
  --instalar) timer_instalar red cada:60 --revisar && echo "✓ Miro internet cada minuto y te aviso de los cortes"; exit 0 ;;
  --desinstalar) timer_desinstalar red; rm -f "$caido"; echo "✓ Vigía de internet apagado"; exit 0 ;;
  --cortes) [ -s "$hist" ] && tail -15 "$hist" || echo "Sin cortes registrados."; exit 0 ;;
  --revisar)
    ahora=$(date +%s)
    if hay_internet; then
      [ -f "$caido" ] || exit 0
      desde=$(cat "$caido"); rm -f "$caido"; dur=$((ahora - desde))
      [ $dur -ge $(( ${RED_MINIMO:-2} * 60 )) ] || exit 0     # un parpadeo no es un corte
      linea="$(date -d "@$desde" '+%d/%m %H:%M') → $(date '+%H:%M') · $(duracion $dur)"
      echo "$linea" >> "$hist"
      texto="Se cortó internet: $linea"
      notificar "Volvió internet" "$texto" aviso
      ausente && al_celular "Volvió internet" "$texto"
    else
      [ -f "$caido" ] || echo "$ahora" > "$caido"
    fi
    exit 0 ;;
  -h|--help) sed -n 2,9p "$0"; exit 0 ;;
esac

# ── El parte ─────────────────────────────────────────────────────────────────
ok() { printf '  \033[32m✓\033[0m %s\n' "$1"; }; mal() { printf '  \033[31m✗\033[0m %s\n' "$1"; }; dato() { printf '  · %s\n' "$1"; }
if p=$(ping -c4 -i0.3 -W3 "$blanco" 2>/dev/null | awk -F/ '/^rtt|^round-trip/{printf "%.0f", $5}') && [ -n "$p" ]; then
  ok "Internet: anda (latencia $p ms a $blanco)"
else mal "Internet: no responde $blanco"; fi
if getent hosts anthropic.com >/dev/null 2>&1; then ok "DNS: resuelve"; else mal "DNS: no resuelve nombres"; fi
gw=$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')
[ -n "$gw" ] && { ping -c1 -W2 "$gw" >/dev/null 2>&1 && ok "Router ($gw): responde" || mal "Router ($gw): no responde"; } || mal "Sin ruta por defecto (¿desconectado?)"
ip_pub=$(curl -fsS -m 5 https://ifconfig.me 2>/dev/null) && dato "IP pública: $ip_pub"
if command -v nmcli >/dev/null; then
  w=$(nmcli -t -f ACTIVE,SSID,SIGNAL dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2" (señal "$3"%)"; exit}')
  [ -n "$w" ] && dato "Wifi: $w"
  c=$(nmcli -t -f TYPE,STATE dev 2>/dev/null | awk -F: '$1=="ethernet" && $2=="connected"{print "sí"; exit}')
  [ -n "$c" ] && dato "Cable: conectado"
fi
command -v tailscale >/dev/null && tailscale status >/dev/null 2>&1 && dato "Tailscale: conectado ($(tailscale ip -4 2>/dev/null | head -1))"
[ -f "$caido" ] && mal "Sin internet desde las $(date -d "@$(cat "$caido")" '+%H:%M')"
[ -s "$hist" ] && dato "Último corte: $(tail -1 "$hist")"
systemctl --user is-active claude-gadgets-red.timer >/dev/null 2>&1 || dato "Para que te avise de los cortes: claude-red --instalar"
exit 0
