#!/bin/bash
# Mensaje de commit escrito por Claude a partir de lo que está en stage, con el
# estilo de los últimos commits del repo. Te lo muestra y vos decidís.
#   claude-commit         propone el mensaje: [S]í, [e]ditar, [n]o
#   claude-commit -a      antes hace git add -A
#   claude-commit -s      commitea sin preguntar
#   claude-commit -m      sólo imprime el mensaje (para usarlo en otro lado)
# Config: COMMIT_MODELO=sonnet
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
[ -f $HOME/.config/claude-gadgets/config ] && . $HOME/.config/claude-gadgets/config
[ -f $HOME/.claude/gadgets/bin/comun.sh ] && . $HOME/.claude/gadgets/bin/comun.sh
todo=0; sin_preguntar=0; solo_mensaje=0
for a in "$@"; do case "$a" in
  -a) todo=1 ;; -s) sin_preguntar=1 ;; -m) solo_mensaje=1 ;;
  -h|--help) sed -n 2,8p "$0"; exit 0 ;;
  *) echo "Opción desconocida: $a"; exit 1 ;;
esac; done
git rev-parse --git-dir >/dev/null 2>&1 || { echo "Acá no hay un repo git."; exit 1; }
[ $todo = 1 ] && git add -A
git diff --cached --quiet && { echo "No hay nada en stage. Usá git add, o claude-commit -a para sumar todo."; exit 1; }

msj=$(mktemp); trap 'rm -f "$msj"' EXIT
claude_texto "${COMMIT_MODELO:-sonnet}" "Escribí el mensaje de commit para estos cambios.
- Primer renglón: qué cambia y para qué, en imperativo o como lo hagan los commits anteriores, hasta 72 caracteres, sin punto final.
- Si hace falta, un renglón en blanco y un cuerpo breve con el porqué (no un inventario de archivos).
- Mismo idioma y mismo estilo que los commits anteriores del repo.
- Respondé SOLAMENTE el mensaje: sin comillas, sin markdown, sin firmas.

<commits_anteriores>
$(git log -10 --format=%s 2>/dev/null)
</commits_anteriores>

<archivos>
$(git diff --cached --stat | tail -40)
</archivos>

<diff>
$(git diff --cached | head -c 90000)
</diff>" | sed 's/^```.*//' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' > "$msj"
[ -s "$msj" ] || { echo "No pude consultar a Claude."; exit 1; }

if [ $solo_mensaje = 1 ]; then cat "$msj"; exit 0; fi
echo; sed 's/^/  /' "$msj"; echo
if [ $sin_preguntar = 1 ]; then git commit -q -F "$msj" && git log --oneline -1; exit; fi
read -r -p "¿Commiteo con este mensaje? [S]í / [e]ditar / [n]o: " r
case "${r,,}" in
  ""|s|si|sí|y) git commit -q -F "$msj" && git log --oneline -1 ;;
  e*) git commit -e -F "$msj" ;;
  *) echo "No commiteé nada. Lo que estaba en stage sigue ahí." ;;
esac
