[Desktop Entry]
Type=Service
MimeType=application/octet-stream;text/plain;application/pdf;image/*;
Actions=preguntarClaude
X-KDE-Priority=TopLevel

[Desktop Action preguntarClaude]
Name=Preguntarle a Claude
Icon=dialog-question
Exec=sh -c 'exec "$HOME/.claude/gadgets/bin/claude-archivo" "$@"' claude-archivo %F
