[Desktop Entry]
Type=Service
MimeType=application/octet-stream;text/plain;application/pdf;image/*;audio/*;
Actions=preguntarClaude;renombrarClaude;resumirClaude;transcribirAudio
X-KDE-Priority=TopLevel

[Desktop Action preguntarClaude]
Name=Preguntarle a Claude
Icon=dialog-question
Exec=sh -c 'exec "$HOME/.claude/gadgets/bin/claude-archivo" "$@"' claude-archivo %F

[Desktop Action renombrarClaude]
Name=Renombrar con Claude
Icon=edit-rename
Exec=sh -c 'exec "$HOME/.claude/gadgets/bin/claude-renombrar" "$@"' claude-renombrar %F

[Desktop Action resumirClaude]
Name=Resumir con Claude
Icon=view-list-text
Exec=sh -c 'exec "$HOME/.claude/gadgets/bin/claude-resumir" --ventana "$1"' claude-resumir %f

[Desktop Action transcribirAudio]
Name=Transcribir audio
Icon=audio-input-microphone
Exec=sh -c 'exec "$HOME/.claude/gadgets/bin/claude-dictar" "$1" | kdialog --textbox - 700 400' claude-dictar %f
